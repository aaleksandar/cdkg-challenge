# The apps' keys and settings: copy to src/kuzu/.env. Loaded by the src/kuzu
# scripts and by the ingestion panel (src/ingest/config.py).

# Required: every LLM call (tags, Text2Cypher, answers, the evaluate.py judge).
GOOGLE_API_KEY=

# Optional: the caption fallback when YouTube refuses yt-dlp. Free plan: 100
# credits a month, 1 per talk; the panel stops at SUPADATA_MONTHLY_CREDITS.
SUPADATA_API_KEY=
# SUPADATA_MONTHLY_CREDITS=100

# Optional: lets "Sync HeySummit" refresh the programme from the API. Without
# it the sync joins from the committed catalogue.
HEYSUMMIT_API_TOKEN=

# The ingestion panel's login. With no password it refuses every request,
# unless ALLOW_ANONYMOUS_PANEL=true — for a panel on your own machine only.
# ADMIN_USER=admin
# ADMIN_PASSWORD=
ALLOW_ANONYMOUS_PANEL=true

# Optional, local only: publish talks to GitHub from a panel on this machine.
# Production reads these from the Actions secrets CDKG_GITHUB_APP_ID and
# CDKG_GITHUB_APP_PRIVATE_KEY (base64 of the PEM on one line).
# GIT_PUSH_ENABLED=false
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=

# Optional: what an ingestion costs, in USD per million tokens. Tokens are
# always recorded; money is shown only when these are set. Take the figures
# from the provider's pricing page for the model pinned in baml_src/clients.baml.
INGEST_INPUT_COST_PER_MTOK=
INGEST_OUTPUT_COST_PER_MTOK=
INGEST_CACHED_INPUT_COST_PER_MTOK=
