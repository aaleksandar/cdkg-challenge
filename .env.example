CDKG_DOMAIN=
SERVER_IP=
SSH_USER=
SSH_PORT=
SSH_KEY=

KAMAL_REGISTRY_USERNAME=
KAMAL_REGISTRY_PASSWORD=

GOOGLE_API_KEY=

# --- Ingestion service (admin panel) ---
CDKG_ADMIN_DOMAIN=
ADMIN_USER=
ADMIN_PASSWORD=

# The GitHub App that publishes talks as one pull request is not configured
# here either: production reads it from the Actions secrets CDKG_GITHUB_APP_ID
# and CDKG_GITHUB_APP_PRIVATE_KEY (GitHub forbids secret names starting with
# GITHUB_), and a local panel reads GITHUB_APP_ID / GITHUB_APP_PRIVATE_KEY from
# src/kuzu/.env. Scope the App to Contents and Pull requests, read & write, on
# this repository only, and protect main so it can never push there directly.

# What an ingestion costs, in USD per million tokens. Tokens are always recorded;
# money is shown only when these are set, because a price hardcoded in the repo
# becomes wrong the moment the provider moves it. Take the current figures from
# the provider's pricing page for the model pinned in baml_src/clients.baml.
INGEST_INPUT_COST_PER_MTOK=
INGEST_OUTPUT_COST_PER_MTOK=
INGEST_CACHED_INPUT_COST_PER_MTOK=
