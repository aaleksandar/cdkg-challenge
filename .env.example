# Deploy variables, read by config/deploy.yml when you run `kamal` from this
# machine. Secrets do not go here: they go in .kamal/secrets (template:
# .kamal/secrets.example), and production takes them from the repository's
# Actions secrets. The apps' own keys and settings are in src/kuzu/.env
# (template: src/kuzu/.env.example).

CDKG_DOMAIN=
SERVER_IP=
SSH_USER=
SSH_PORT=
SSH_KEY=

KAMAL_REGISTRY_USERNAME=
KAMAL_REGISTRY_PASSWORD=

# Optional: where kamal-proxy serves the Ladybug Explorer (default explorer.eudaform.org)
EXPLORER_DOMAIN=
